# Fill in the values before importing this file into Vercel.
# Set the variables for Production, Preview, and Development as needed.

# Required: Supabase project settings (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Required: public deployment URL and admin allowlist
NEXT_PUBLIC_APP_URL=
ADMIN_EMAILS=
CRON_SECRET=

# Required for bank transfer QR/order creation
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Optional additional accounts: JSON array with id, account, name, note, automatic.
# Example: PAYMENT_BANK_ACCOUNTS=[{"id":"970436","account":"0123456789","name":"ADMIN NAME","note":"Ghi chú riêng cho tài khoản","automatic":false}]
PAYMENT_BANK_ACCOUNTS=
BANK_NOTE=
BANK_AUTOMATIC=true

# Configure at least one provider used for payment confirmation
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=

# Optional payment channels
BANK_ID_2=
BANK_ACCOUNT_NO_2=
BANK_ACCOUNT_NAME_2=
BANK_NOTE_2=
BANK_2_AUTOMATIC=false
MOMO_PHONE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_HASH_SECRET=

# Optional integrations; Yeulink is needed for free-key short links
YEULINK_TOKEN=
MINECRAFT_API_KEY=
